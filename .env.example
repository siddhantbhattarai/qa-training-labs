# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database (OPTIONAL) ─────────────────────────────────────────────────────
# Leave MONGODB_URI BLANK for zero-config mode: the app boots an in-memory
# MongoDB automatically and auto-seeds demo data. Nothing to install.
#
# Set it only if you want data to persist across restarts:
#   Local:  mongodb://localhost:27017/qa-training-lab
#   Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_URI=

# ─── Difficulty (OPTIONAL) ───────────────────────────────────────────────────
# Default difficulty level when none is chosen: low | medium | high | stable
# (You can also switch live from the UI dropdown or the X-QA-Level header.)
# DEFAULT_QA_LEVEL=low

# ─── Daily clean-up (OPTIONAL) ───────────────────────────────────────────────
# The lab wipes test data and re-seeds fresh every N hours so a shared
# environment stays clean. Default 24. Set to 0 to disable.
# AUTO_RESET_HOURS=24

# ─── JWT ─────────────────────────────────────────────────────────────────────
# These placeholders are fine for local dev. In production (NODE_ENV=production)
# the app REFUSES to start unless you replace these with your own strong, random
# secrets (e.g. `openssl rand -base64 32`).
JWT_SECRET=qa-lab-access-secret-change-me-please-32chars
JWT_REFRESH_SECRET=qa-lab-refresh-secret-change-me-please-32chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ─── Seed admin (OPTIONAL) ───────────────────────────────────────────────────
ADMIN_EMAIL=admin@qalab.com
ADMIN_PASSWORD=Admin@1234
